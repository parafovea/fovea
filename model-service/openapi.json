{
  "components": {
    "schemas": {
      "AudioOverrides": {
        "description": "Per-request overrides for transcription and diarization.",
        "properties": {
          "beam_size": {
            "anyOf": [
              {
                "maximum": 10,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Decoder beam width",
            "title": "Beam Size"
          },
          "compute_type": {
            "anyOf": [
              {
                "enum": [
                  "float16",
                  "float32",
                  "int8",
                  "int8_float16"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Transcriber compute precision",
            "title": "Compute Type"
          },
          "max_speakers": {
            "anyOf": [
              {
                "maximum": 20,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Speakers"
          },
          "min_speakers": {
            "anyOf": [
              {
                "maximum": 20,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Speakers"
          },
          "num_speakers": {
            "anyOf": [
              {
                "maximum": 20,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact speaker count (skips auto-detect)",
            "title": "Num Speakers"
          },
          "vad_threshold": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Voice-activity detection probability threshold",
            "title": "Vad Threshold"
          }
        },
        "title": "AudioOverrides",
        "type": "object"
      },
      "AugmentRequest": {
        "description": "Request body for the ontology augmentation endpoint.",
        "properties": {
          "domain": {
            "description": "Domain description for context",
            "minLength": 1,
            "title": "Domain",
            "type": "string"
          },
          "existing_types": {
            "description": "Existing type names",
            "items": {
              "type": "string"
            },
            "title": "Existing Types",
            "type": "array"
          },
          "max_suggestions": {
            "default": 10,
            "description": "Maximum suggestions to return",
            "maximum": 50,
            "minimum": 1,
            "title": "Max Suggestions",
            "type": "integer"
          },
          "persona_id": {
            "description": "Unique identifier for the persona",
            "minLength": 1,
            "title": "Persona Id",
            "type": "string"
          },
          "target_category": {
            "description": "Category to augment",
            "enum": [
              "entity",
              "event",
              "role",
              "relation"
            ],
            "title": "Target Category",
            "type": "string"
          }
        },
        "required": [
          "persona_id",
          "domain",
          "target_category"
        ],
        "title": "AugmentRequest",
        "type": "object"
      },
      "AugmentResponse": {
        "description": "Response body for the ontology augmentation endpoint.",
        "properties": {
          "id": {
            "description": "Unique identifier for this augmentation",
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "persona_id": {
            "description": "Persona identifier",
            "minLength": 1,
            "title": "Persona Id",
            "type": "string"
          },
          "reasoning": {
            "description": "Explanation of why these types were suggested",
            "title": "Reasoning",
            "type": "string"
          },
          "suggestions": {
            "description": "Suggested types",
            "items": {
              "$ref": "#/components/schemas/OntologyType"
            },
            "title": "Suggestions",
            "type": "array"
          },
          "target_category": {
            "description": "Category that was augmented",
            "title": "Target Category",
            "type": "string"
          }
        },
        "required": [
          "id",
          "persona_id",
          "target_category",
          "reasoning"
        ],
        "title": "AugmentResponse",
        "type": "object"
      },
      "BoundingBox": {
        "description": "Bounding box coordinates, normalized to [0, 1].",
        "properties": {
          "height": {
            "description": "Box height (normalized)",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Height",
            "type": "number"
          },
          "width": {
            "description": "Box width (normalized)",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Width",
            "type": "number"
          },
          "x": {
            "description": "X coordinate (normalized)",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "Y coordinate (normalized)",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "BoundingBox",
        "type": "object"
      },
      "ClaimExtractionRequest": {
        "description": "Request body for the claim extraction endpoint.",
        "properties": {
          "annotations": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/JsonValue"
                  },
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Annotation data for context",
            "title": "Annotations"
          },
          "extraction_strategy": {
            "default": "sentence-based",
            "description": "Strategy for extracting claims",
            "enum": [
              "sentence-based",
              "semantic-units",
              "hierarchical"
            ],
            "title": "Extraction Strategy",
            "type": "string"
          },
          "max_claims": {
            "default": 50,
            "description": "Maximum number of claims to extract",
            "maximum": 200,
            "minimum": 1,
            "title": "Max Claims",
            "type": "integer"
          },
          "min_confidence": {
            "default": 0.5,
            "description": "Minimum confidence threshold for claims",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Confidence",
            "type": "number"
          },
          "ontology_glosses": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Map of type ID to gloss text",
            "title": "Ontology Glosses"
          },
          "ontology_types": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/JsonValue"
                  },
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Ontology type definitions for context",
            "title": "Ontology Types"
          },
          "sentences": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Pre-split sentences (optional)",
            "title": "Sentences"
          },
          "summary_id": {
            "description": "Unique identifier for the summary",
            "minLength": 1,
            "title": "Summary Id",
            "type": "string"
          },
          "summary_text": {
            "description": "Full summary text to extract claims from",
            "minLength": 1,
            "title": "Summary Text",
            "type": "string"
          }
        },
        "required": [
          "summary_id",
          "summary_text"
        ],
        "title": "ClaimExtractionRequest",
        "type": "object"
      },
      "ClaimExtractionResponse": {
        "description": "Response body for the claim extraction endpoint.",
        "properties": {
          "claims": {
            "description": "Extracted claims",
            "items": {
              "$ref": "#/components/schemas/ExtractedClaim"
            },
            "title": "Claims",
            "type": "array"
          },
          "model_used": {
            "description": "LLM model used for extraction",
            "minLength": 1,
            "title": "Model Used",
            "type": "string"
          },
          "processing_time": {
            "description": "Processing time in seconds",
            "minimum": 0.0,
            "title": "Processing Time",
            "type": "number"
          },
          "summary_id": {
            "description": "Summary identifier",
            "minLength": 1,
            "title": "Summary Id",
            "type": "string"
          }
        },
        "required": [
          "summary_id",
          "model_used",
          "processing_time"
        ],
        "title": "ClaimExtractionResponse",
        "type": "object"
      },
      "ClaimRelationship": {
        "description": "Relationship between claims across sources.",
        "properties": {
          "confidence": {
            "default": 0.8,
            "description": "Confidence score",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional notes",
            "title": "Notes"
          },
          "relation_type": {
            "description": "Type of relationship",
            "enum": [
              "supports",
              "conflicts_with",
              "contradicts",
              "refines",
              "generalizes",
              "duplicates"
            ],
            "title": "Relation Type",
            "type": "string"
          },
          "source_claim_id": {
            "description": "Source claim ID",
            "minLength": 1,
            "title": "Source Claim Id",
            "type": "string"
          },
          "target_claim_id": {
            "description": "Target claim ID",
            "minLength": 1,
            "title": "Target Claim Id",
            "type": "string"
          }
        },
        "required": [
          "source_claim_id",
          "target_claim_id",
          "relation_type"
        ],
        "title": "ClaimRelationship",
        "type": "object"
      },
      "ClaimSource": {
        "description": "Source of claims for synthesis (single video or collection).",
        "properties": {
          "claims": {
            "description": "Hierarchical claim structure",
            "items": {
              "additionalProperties": {
                "$ref": "#/components/schemas/JsonValue"
              },
              "type": "object"
            },
            "title": "Claims",
            "type": "array"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Source metadata (video title, date, etc.)",
            "title": "Metadata"
          },
          "source_id": {
            "description": "Video ID or collection ID",
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "source_type": {
            "description": "Type of source",
            "enum": [
              "video",
              "collection"
            ],
            "title": "Source Type",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "source_type"
        ],
        "title": "ClaimSource",
        "type": "object"
      },
      "Detection": {
        "description": "Single object detection result.",
        "properties": {
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox",
            "description": "Bounding box coordinates"
          },
          "confidence": {
            "description": "Detection confidence score",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "label": {
            "description": "Detected object label",
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "track_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Tracking ID across frames",
            "title": "Track Id"
          }
        },
        "required": [
          "label",
          "bounding_box",
          "confidence"
        ],
        "title": "Detection",
        "type": "object"
      },
      "DetectionRequest": {
        "description": "Request body for the object detection endpoint.",
        "properties": {
          "confidence_threshold": {
            "default": 0.3,
            "description": "Minimum confidence for detections",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Threshold",
            "type": "number"
          },
          "enable_tracking": {
            "default": true,
            "description": "Whether to enable object tracking",
            "title": "Enable Tracking",
            "type": "boolean"
          },
          "frame_numbers": {
            "description": "Specific frames to process",
            "items": {
              "type": "integer"
            },
            "title": "Frame Numbers",
            "type": "array"
          },
          "query": {
            "description": "Text query describing objects to detect",
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "video_id": {
            "description": "Unique identifier for the video",
            "minLength": 1,
            "title": "Video Id",
            "type": "string"
          },
          "video_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional full path to video file",
            "title": "Video Path"
          }
        },
        "required": [
          "video_id",
          "query"
        ],
        "title": "DetectionRequest",
        "type": "object"
      },
      "DetectionResponse": {
        "description": "Response body for the object detection endpoint.",
        "properties": {
          "frames": {
            "description": "Frames with detections",
            "items": {
              "$ref": "#/components/schemas/FrameDetections"
            },
            "title": "Frames",
            "type": "array"
          },
          "id": {
            "description": "Unique identifier for this detection job",
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "processing_time": {
            "description": "Processing time in seconds",
            "minimum": 0.0,
            "title": "Processing Time",
            "type": "number"
          },
          "query": {
            "description": "Query that was used",
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "total_detections": {
            "description": "Total detections across all frames",
            "minimum": 0,
            "title": "Total Detections",
            "type": "integer"
          },
          "video_id": {
            "description": "Video identifier",
            "minLength": 1,
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "video_id",
          "query",
          "total_detections",
          "processing_time"
        ],
        "title": "DetectionResponse",
        "type": "object"
      },
      "ExtractedClaim": {
        "description": "Single extracted claim with metadata and nested subclaims.",
        "properties": {
          "char_end": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Character offset end in summary text",
            "title": "Char End"
          },
          "char_start": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Character offset in summary text",
            "title": "Char Start"
          },
          "claim_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Semantic type of claim",
            "title": "Claim Type"
          },
          "confidence": {
            "description": "Model confidence in claim extraction",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "sentence_index": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Index of source sentence (if sentence-based)",
            "title": "Sentence Index"
          },
          "subclaims": {
            "description": "Nested subclaims",
            "items": {
              "$ref": "#/components/schemas/ExtractedClaim"
            },
            "title": "Subclaims",
            "type": "array"
          },
          "text": {
            "description": "Claim text",
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "thinking": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ThinkingTrace"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional reasoning trace from a thinking-capable model"
          }
        },
        "required": [
          "text",
          "confidence"
        ],
        "title": "ExtractedClaim",
        "type": "object"
      },
      "FrameDetections": {
        "description": "Detections for a single video frame.",
        "properties": {
          "detections": {
            "description": "Detections in this frame",
            "items": {
              "$ref": "#/components/schemas/Detection"
            },
            "title": "Detections",
            "type": "array"
          },
          "frame_number": {
            "description": "Frame number in the video",
            "minimum": 0,
            "title": "Frame Number",
            "type": "integer"
          },
          "timestamp": {
            "description": "Time in seconds from video start",
            "minimum": 0.0,
            "title": "Timestamp",
            "type": "number"
          }
        },
        "required": [
          "frame_number",
          "timestamp"
        ],
        "title": "FrameDetections",
        "type": "object"
      },
      "GenerationOverrides": {
        "description": "Per-request overrides for LLM/VLM sampling parameters.",
        "properties": {
          "max_tokens": {
            "anyOf": [
              {
                "maximum": 32768,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Maximum tokens to generate",
            "title": "Max Tokens"
          },
          "temperature": {
            "anyOf": [
              {
                "maximum": 2.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Sampling temperature override",
            "title": "Temperature"
          },
          "top_p": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Nucleus sampling probability mass",
            "title": "Top P"
          }
        },
        "title": "GenerationOverrides",
        "type": "object"
      },
      "JsonValue": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "items": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "array"
          },
          {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "KeyFrame": {
        "description": "Key frame information from video analysis.",
        "properties": {
          "confidence": {
            "default": 0.0,
            "description": "Model confidence score",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "description": {
            "description": "Frame description",
            "title": "Description",
            "type": "string"
          },
          "frame_number": {
            "description": "Frame number in the video",
            "title": "Frame Number",
            "type": "integer"
          },
          "timestamp": {
            "description": "Time in seconds from video start",
            "minimum": 0.0,
            "title": "Timestamp",
            "type": "number"
          }
        },
        "required": [
          "frame_number",
          "timestamp",
          "description"
        ],
        "title": "KeyFrame",
        "type": "object"
      },
      "OntologyType": {
        "description": "Suggested ontology type from augmentation.",
        "properties": {
          "confidence": {
            "default": 0.0,
            "description": "Confidence score",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "description": {
            "description": "Type description",
            "title": "Description",
            "type": "string"
          },
          "examples": {
            "description": "Example instances",
            "items": {
              "type": "string"
            },
            "title": "Examples",
            "type": "array"
          },
          "name": {
            "description": "Type name",
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Parent type name",
            "title": "Parent"
          },
          "thinking": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ThinkingTrace"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional reasoning trace from a thinking-capable model"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "title": "OntologyType",
        "type": "object"
      },
      "SummarizeRequest": {
        "description": "Request body for the video summarization endpoint.",
        "properties": {
          "audio_language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Audio language code (e.g., 'en')",
            "title": "Audio Language"
          },
          "audio_overrides": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AudioOverrides"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Per-request transcription/diarization overrides"
          },
          "enable_audio": {
            "default": false,
            "description": "Enable audio transcription",
            "title": "Enable Audio",
            "type": "boolean"
          },
          "enable_speaker_diarization": {
            "default": false,
            "description": "Enable speaker identification",
            "title": "Enable Speaker Diarization",
            "type": "boolean"
          },
          "frame_sample_rate": {
            "default": 1,
            "description": "Frames to sample per second",
            "maximum": 10,
            "minimum": 1,
            "title": "Frame Sample Rate",
            "type": "integer"
          },
          "fusion_strategy": {
            "anyOf": [
              {
                "enum": [
                  "sequential",
                  "timestamp_aligned",
                  "native_multimodal",
                  "hybrid"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "sequential",
            "description": "Audio-visual fusion strategy",
            "title": "Fusion Strategy"
