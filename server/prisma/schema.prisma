// Prisma Schema for Fovea Video Annotation Tool
// This schema defines the database structure for personas, videos, ontologies, annotations, and summaries
//
// INDEXING STRATEGY (EVALUATION.md Phase 9):
// - Foreign keys (videoId, personaId, userId) are indexed for JOIN performance and query filtering
// - Timestamp fields (createdAt) are indexed for temporal queries and chronological sorting
// - Composite indexes (e.g., videoId+personaId) optimize common query patterns accessing both fields
// - Indexes are automatically utilized by the PostgreSQL query planner for improved performance
// - Each index adds ~1-5MB storage overhead but provides 50-90% query speedup on large datasets

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

/// User represents an authenticated user of the system
model User {
  id           String  @id @default(uuid())
  username     String  @unique
  email        String? @unique
  passwordHash String? // Nullable for single-user mode default user
  displayName  String
  isAdmin      Boolean @default(false)
  systemRole   String  @default("user") // "system_admin" or "user"

  // Relationships
  personas Persona[]
  apiKeys  ApiKey[]
  sessions Session[]

  // RBAC relationships
  groupMemberships   GroupMembership[]
  projectMemberships ProjectMembership[]
  ownedProjects      Project[]                @relation("OwnedProjects")
  videoAssignments   ProjectVideoAssignment[] @relation("VideoAssignments")
  sharedByMe         ResourceShare[]          @relation("SharedByMe")
  sharedWithMe       ResourceShare[]          @relation("SharedWithMe")

  // Per-user inference preferences (1:1, created on-demand)
  preferences       UserPreferences?
  systemConfigEdits SystemConfig[]   @relation("SystemConfigUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// UserPreferences stores per-user inference sampling/audio/detection overrides.
///
/// The `inferencePreferences` JSON column holds a partial object matching the
/// shape of the `InferencePreferences` type on the frontend. Null/missing
/// fields mean "defer to backend default" — there are no null fields forced
/// into every row. The row is created lazily when a user first writes a
/// preference and upserted on every subsequent edit.
model UserPreferences {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// JSON structure: InferencePreferences (see annotation-tool/src/store/preferences/useInferencePreferences.ts)
  inferencePreferences Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

/// Session stores user authentication sessions
model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId, expiresAt])
  @@map("sessions")
}

/// LoginAttempt tracks failed login attempts for lockout mechanism
model LoginAttempt {
  id        String   @id @default(uuid())
  username  String
  ipAddress String?
  success   Boolean
  failedAt  DateTime @default(now())

  @@index([username, failedAt])
  @@map("login_attempts")
}

/// ApiKey stores encrypted API keys for external services (user-level or admin-level)
model ApiKey {
  id     String  @id @default(uuid())
  userId String? // NULL for admin-level keys
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Provider: anthropic, openai, google, cohere, mistral, aws, azure, roboflow, cloudsight, edenai
  provider     String
  /// User-friendly label for this key
  keyName      String
  /// AES-256-GCM encrypted API key
  encryptedKey String
  /// Last 4 characters for display (e.g., "...Xy9Z")
  keyMask      String
  /// Whether this key is active
  isActive     Boolean   @default(true)
  /// Last time this key was used
  lastUsed     DateTime?
  /// Number of times this key has been used
  usageCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([provider])
  @@map("api_keys")
}

/// Persona represents an analyst or user with their own ontology and interpretations
model Persona {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  role              String
  informationNeed   String
  details           String?
  isSystemGenerated Boolean @default(false)
  hidden            Boolean @default(false)

  /// Layers persona fields (mirror pub.layers.persona.persona).
  /// domain scopes the annotator; kind distinguishes human/model/ensemble;
  /// guidelines holds the annotation instructions in guidelinesFormat (e.g. markdown).
  domain           String?
  kind             String?
  guidelines       String? @db.Text
  guidelinesFormat String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videoSummaries VideoSummary[]

  // Layers annotation store back-relations
  annotationLayers AnnotationLayer[]
  layersOntologies LayersOntology[]

  // Per-persona inference preferences (1:1, created on-demand)
  preferences PersonaPreferences?

  @@index([projectId])
  @@map("personas")
}

/// PersonaPreferences stores per-persona inference overrides layered on top
/// of the owning user's UserPreferences.
///
/// Merge order at request time: user defaults → persona overrides → per-request
/// overrides (most specific wins). The `inferencePreferences` column stores a
/// partial object; omitted fields fall through to the user level.
model PersonaPreferences {
  id        String  @id @default(uuid())
  personaId String  @unique
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  /// JSON structure: Partial<InferencePreferences>
  inferencePreferences Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("persona_preferences")
}

/// SystemConfig is an admin-only key-value store for system-wide settings
/// (storage roots, CUDA device, warmup, external API endpoints). Each
/// mutation bumps `version` and records `updatedByUserId` for audit.
///
/// Keys are validated against a discriminated TypeBox schema at the API
/// boundary so the `value` column always matches the shape advertised for
/// its key.
model SystemConfig {
  key             String  @id
  value           Json
  version         Int     @default(1)
  updatedByUserId String?
  updatedBy       User?   @relation("SystemConfigUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

/// Video represents a video file with its metadata
model Video {
  id         String   @id @default(uuid())
  filename   String   @unique
  path       String
  duration   Float?
  frameRate  Float?
  resolution String?
  /// Additional metadata stored as JSON
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Local thumbnail path (relative to STORAGE_PATH/thumbnails)
  localThumbnailPath String?
  /// Last successful metadata sync timestamp
  lastMetadataSync   DateTime?
  /// Platform this video originated from (e.g., 'twitter', 'youtube')
  sourcePlatform     String?
  /// Platform-specific video ID
  platformVideoId    String?
  /// Metadata sync status: 'synced', 'failed', 'never'
  metadataSyncStatus String?

  summaries          VideoSummary[]
  projectAssignments ProjectVideoAssignment[]

  // Layers annotation store back-relations
  mediaRecords Media[]
  expressions  Expression[]

  @@map("videos")
}

/// VideoSummary stores AI-generated or manual summaries of videos for specific personas
model VideoSummary {
  id        String  @id @default(uuid())
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  /// JSON structure: GlossItem[] - array of {type, content, refType?, refPersonaId?, refClaimId?}
  summary         Json    @default("[]")
  visualAnalysis  String?
  audioTranscript String?
  /// JSON structure for key frame data
  keyFrames       Json?
  confidence      Float?

  /// Audio metadata fields
  /// JSON structure: {segments: [{start, end, text, speaker, confidence, sentiment}], speakers, language}
  transcriptJson Json?
  /// ISO language code detected from audio (e.g., "en", "es")
  audioLanguage  String?
  /// Number of distinct speakers detected
  speakerCount   Int?

  /// Model metadata
  /// Name of audio transcription model used (e.g., "whisper-v3-turbo", "assemblyai-universal")
  audioModelUsed  String?
  /// Name of visual analysis model used (e.g., "gemini-2-5-flash", "gpt-4o")
  visualModelUsed String?
  /// Audio-visual fusion strategy used (e.g., "sequential", "timestamp_aligned", "native_multimodal", "hybrid")
  fusionStrategy  String?

  /// Processing time metadata (in seconds)
  processingTimeAudio  Float?
  processingTimeVisual Float?
  processingTimeFusion Float?

  /// Processing completion timestamps
  processedAtAudio  DateTime?
  processedAtVisual DateTime?
  processedAtFusion DateTime?

  /// Vector embedding for semantic search (1536 dimensions for OpenAI embeddings)
  embedding Unsupported("vector(1536)")?

  /// Claims extraction metadata
  /// Denormalized claims structure for fast access (JSON)
  /// Structure: { version: string, claims: Claim[], metadata: {...} }
  claimsJson        Json?
  /// Version of claim extraction algorithm used
  claimsVersion     String?
  /// Timestamp when claims were last extracted
  claimsExtractedAt DateTime?

  /// Comment/notes field for annotator notes at video level
  comment String? @db.Text

  /// Layers expressions projected from this summary
  expressions Expression[]

  /// User who created this summary (or service ID for automated summaries)
  createdBy String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoId, personaId])
  @@index([videoId])
  @@index([personaId])
  @@index([createdAt])
  @@index([videoId, personaId])
  @@index([projectId])
  @@map("video_summaries")
}

/// ImportHistory tracks data imports from JSON Lines files
model ImportHistory {
  id            String   @id @default(uuid())
  filename      String
  importedBy    String?
  importOptions Json
  result        Json
  success       Boolean
  itemsImported Int
  itemsSkipped  Int
  createdAt     DateTime @default(now())

  @@map("import_history")
}

// =============================================================================
// RBAC Models (Role-Based Access Control)
// =============================================================================

/// UserGroup represents a collection of users who share access to projects and resources
model UserGroup {
  id          String  @id @default(uuid())
  name        String
  description String?
  slug        String  @unique

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        GroupMembership[]
  projects       Project[]
  resourceShares ResourceShare[]

  @@map("user_groups")
}

/// GroupMembership tracks user membership and role within a group
model GroupMembership {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String
  group    UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role     String // "group_owner", "group_admin", "group_member"
  joinedAt DateTime  @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("group_memberships")
}

/// Project organizes videos, annotations, and team members around a shared goal
model Project {
  id           String     @id @default(uuid())
  name         String
  description  String?
  slug         String     @unique
  ownerUserId  String?
  ownerUser    User?      @relation("OwnedProjects", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerGroupId String?
  ownerGroup   UserGroup? @relation(fields: [ownerGroupId], references: [id], onDelete: SetNull)
  settings     Json       @default("{}")
  isArchived   Boolean    @default(false)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          ProjectMembership[]
  videoAssignments ProjectVideoAssignment[]
  personas         Persona[]
  videoSummaries   VideoSummary[]

  // Layers annotation store back-relations
  media                   Media[]
  expressions             Expression[]
  segmentations           Segmentation[]
  annotationLayers        AnnotationLayer[]
  layersAnnotations       LayersAnnotation[]
  textAnnotationRelations TextAnnotationRelation[]
  graphNodes              GraphNode[]
  graphEdges              GraphEdge[]
  layersOntologies        LayersOntology[]
  typeDefs                TypeDef[]
  corpora                 Corpus[]
  clusterSets             ClusterSet[]
  alignments              Alignment[]

  @@map("projects")
}

/// ProjectMembership tracks user membership and role within a project
model ProjectMembership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String // "project_owner", "project_manager", "annotator", "reviewer", "viewer"
  joinedAt  DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("project_memberships")
}

/// ProjectVideoAssignment links videos to projects with optional user assignment
model ProjectVideoAssignment {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoId        String
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?    @relation("VideoAssignments", fields: [assignedUserId], references: [id], onDelete: SetNull)
  source         String   @default("manual") // "manual" or "rule"
  ruleDefinition Json?
  assignedBy     String?
  assignedAt     DateTime @default(now())

  @@unique([projectId, videoId])
  @@index([projectId])
  @@index([videoId])
  @@index([assignedUserId])
  @@map("project_video_assignments")
}

/// VideoAssignmentRule defines automatic video-to-project/user/group assignment logic
model VideoAssignmentRule {
  id          String  @id @default(uuid())
  name        String
  description String?
  conditions  Json // [{field, operator, value}]
  targetType  String // "user", "project", "group"
  targetId    String
  isActive    Boolean @default(true)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_assignment_rules")
}

/// ResourceShare tracks sharing of resources (annotations, summaries, claims, etc.) between users and groups
model ResourceShare {
  id                String     @id @default(uuid())
  resourceType      String // "annotation", "summary", "claim", "persona", "world_state"
  resourceId        String
  sharedByUserId    String
  sharedByUser      User       @relation("SharedByMe", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWithUserId  String?
  sharedWithUser    User?      @relation("SharedWithMe", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedWithGroupId String?
  sharedWithGroup   UserGroup? @relation(fields: [sharedWithGroupId], references: [id], onDelete: Cascade)
  permissionLevel   String     @default("read_only") // "read_only" or "forkable"
  expiresAt         DateTime?
  createdAt         DateTime   @default(now())

  @@index([sharedByUserId])
  @@index([sharedWithUserId])
  @@index([sharedWithGroupId])
  @@index([resourceType, resourceId])
  @@map("resource_shares")
}

/// RolePermission defines what actions each role can perform on each resource type
model RolePermission {
  id           String  @id @default(uuid())
  scope        String // "system", "group", "project"
  role         String // e.g., "system_admin", "group_owner", "annotator"
  resourceType String // "video", "persona", "annotation", "summary", "claim", "world_state", "project", "group"
  action       String // "create", "read", "update", "delete", "share", "export", "assign", "manage_members", "fork", "review"
  ownOnly      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, role, resourceType, action])
  @@map("role_permissions")
}

// =============================================================================
// Layers-Shaped Unified Annotation Store
// =============================================================================
// Relational mirror of the pub.layers.* schema. These rows are the source of
// truth across video, audio, and text; layers records are a projection produced
// by the codec at export. Conventions across every model in this section:
//   - Fovea String uuid PK == layers Uuid.value; cross-record refs are internal
//     FK columns (String), never at-uris (the codec emits at-uris on export).
//   - Integer-scale layers facts: confidence is 0-1000, times are ms, frameRate
//     is x100, and TemporalSpan uses `ending` (not `end`).
//   - JSON columns hold layers value-objects, typed as @fovea/layers-schema at
//     the repository layer (not modeled here).
//   - projectId + createdByUserId scope rows for CASL accessibleBy; layersUri is
//     a nullable placeholder for a future PDS publish (unused now).

/// Media mirrors pub.layers.media.media: a piece of source material (or a clip
/// of one) that expressions and annotations attach to.
model Media {
  id String @id @default(uuid())

  /// audio | video | image | document
  kind        String
  title       String?
  description String? @db.Text
  externalUri String?
  blobPath    String?
  mimeType    String?
  /// Duration in milliseconds.
  durationMs  Int?

  /// Self-relation: a clip references the media it was cut from.
  parentMediaId String?
  parentMedia   Media?  @relation("MediaClip", fields: [parentMediaId], references: [id], onDelete: SetNull)
  clips         Media[] @relation("MediaClip")
  /// Clip start offset within the parent media, in milliseconds.
  startOffsetMs Int?

  /// Layers value-objects (audio/video/document descriptors, knowledge refs).
  audio         Json?
  video         Json?
  document      Json?
  knowledgeRefs Json?
  metadata      Json?
  features      Json?
  languages     String[]

  /// The Fovea Video this media was derived from, when applicable.
  /// Named `sourceVideo` because `video` is the layers video descriptor above.
  videoId     String?
  sourceVideo Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  expressions Expression[]

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
  @@index([parentMediaId])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("media")
}

/// Expression mirrors expression.expression: a unit of text or signal (document,
/// transcript, video, summary) that carries tokenizations and annotation layers.
model Expression {
  id String @id @default(uuid())

  /// The layers Expression.id / corpus id this row projects to.
  layersId     String
  kind         String
  text         String? @db.Text
  /// sha256(text) captured at ingest for drift detection.
  sourceDigest String?

  /// Self-relation: sub-expression tree (e.g. document -> sentence).
  parentExpressionId String?
  parentExpression   Expression?  @relation("ExprTree", fields: [parentExpressionId], references: [id], onDelete: Cascade)
  children           Expression[] @relation("ExprTree")

  anchor     Json?
  /// document | video-metadata-text | asr-transcript | video | summary
  sourceKind String

  mediaId        String?
  media          Media?        @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  videoId        String?
  video          Video?        @relation(fields: [videoId], references: [id], onDelete: SetNull)
  videoSummaryId String?
  videoSummary   VideoSummary? @relation(fields: [videoSummaryId], references: [id], onDelete: SetNull)
  corpusId       String?
  corpus         Corpus?       @relation(fields: [corpusId], references: [id], onDelete: SetNull)

  metadata  Json?
  features  Json?
  languages String[]
  sourceUrl String?

  tokenizations    Tokenization[]
  annotationLayers AnnotationLayer[]
  segmentations    Segmentation[]
  memberships      CorpusMembership[]
  clusterSets      ClusterSet[]
  alignments       Alignment[]

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentExpressionId])
  @@index([videoId])
  @@index([videoSummaryId])
  @@index([mediaId])
  @@index([corpusId])
  @@index([sourceKind])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("expressions")
}

/// Segmentation groups tokenizations that share a segmentation of one expression.
model Segmentation {
  id           String     @id @default(uuid())
  expressionId String
  expression   Expression @relation(fields: [expressionId], references: [id], onDelete: Cascade)

  metadata Json?
  features Json?

  tokenizations Tokenization[]

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expressionId])
  @@map("segmentations")
}

/// Tokenization holds one token stream over a segmentation. `id` == the layers
/// tokenization Uuid.value; annotation token offsets index into these tokens.
model Tokenization {
  id String @id @default(uuid())

  segmentationId String
  segmentation   Segmentation @relation(fields: [segmentationId], references: [id], onDelete: Cascade)
  /// The expression whose text the token offsets index into.
  expressionId   String?
  expression     Expression?  @relation(fields: [expressionId], references: [id], onDelete: Cascade)

  kind        String
  isCanonical Boolean @default(true)
  /// JSON: Token[] as [{ tokenIndex, text, textSpan: { byteStart, byteEnd,
  /// charStart?, charEnd? }, temporalSpan?: { start, ending } }].
  tokens      Json
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([segmentationId])
  @@index([expressionId])
  @@map("tokenizations")
}

/// AnnotationLayer mirrors annotation.annotationLayer: a homogeneous layer of
/// annotations over one expression. A set personaId marks an ontology-type layer;
/// a null personaId marks a world-object layer (mirrors Annotation.personaId).
model AnnotationLayer {
  id String @id @default(uuid())

  expressionId String
  expression   Expression @relation(fields: [expressionId], references: [id], onDelete: Cascade)

  /// span | relation | token-tag | tree | graph | tier | document-tag
  kind           String
  subkind        String?
  formalism      String?
  sourceMethod   String  @default("manual-native")
  labelSet       String?
  tokenizationId String?

  ontologyId String?
  ontology   LayersOntology? @relation(fields: [ontologyId], references: [id], onDelete: SetNull)

  /// Self-relation: layer derived from a parent layer.
  parentLayerId String?
  parentLayer   AnnotationLayer?  @relation("LayerTree", fields: [parentLayerId], references: [id], onDelete: SetNull)
  childLayers   AnnotationLayer[] @relation("LayerTree")

  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)

  metadata  Json?
  features  Json?
  languages String[]

  annotations LayersAnnotation[]
  relations   TextAnnotationRelation[]

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expressionId, kind])
  @@index([personaId])
  @@index([ontologyId])
  @@index([parentLayerId])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("annotation_layers")
}

/// LayersAnnotation mirrors annotation.defs#annotation: one span/annotation row.
/// `id` == the layers Annotation Uuid.value. startMs/endMs denormalize the
/// anchor's temporal extent for timeline filtering.
model LayersAnnotation {
  id String @id @default(uuid())

  layerId        String
  layer          AnnotationLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  tokenizationId String?

  /// Polymorphic anchor: tokenRefSequence | temporalSpan | spatioTemporalAnchor
  /// | textSpan | ...
  anchor     Json
  tokenIndex Int?
  label      String?
  value      String? @db.Text
  text       String? @db.Text

  /// Self-relation: nesting within a layer (e.g. constituency tree).
  parentAnnotationId String?
  parentAnnotation   LayersAnnotation?  @relation("AnnTree", fields: [parentAnnotationId], references: [id], onDelete: SetNull)
  childAnnotations   LayersAnnotation[] @relation("AnnTree")
  childIds           Json?

  headIndex   Int?
  targetIndex Int?
  /// JSON: argumentRef[].
  arguments   Json?
  /// Confidence on the layers 0-1000 integer scale.
  confidence  Int?

  /// Soft FK to a TypeDef id when the label denotes an ontology type.
  ontologyTypeRefId String?
  /// World-object link: the graph node this annotation denotes.
  denotesNodeId     String?
  denotesNode       GraphNode? @relation(fields: [denotesNodeId], references: [id], onDelete: SetNull)

  knowledgeRefs Json?
  temporal      Json?
  spatial       Json?
  features      Json?

  /// Denormalized from the anchor's temporalSpan/spatioTemporalAnchor (ms).
  startMs Int?
  endMs   Int?

  sourceRelations TextAnnotationRelation[] @relation("RelSource")
  targetRelations TextAnnotationRelation[] @relation("RelTarget")

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([layerId])
  @@index([tokenizationId])
  @@index([startMs, endMs])
  @@index([denotesNodeId])
  @@index([ontologyTypeRefId])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("layers_annotations")
}

/// TextAnnotationRelation mirrors the bead relation layer: a labeled directed
/// edge between two LayersAnnotations.
model TextAnnotationRelation {
  id String @id @default(uuid())

  layerId String
  layer   AnnotationLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  sourceAnnotationId String
  sourceAnnotation   LayersAnnotation @relation("RelSource", fields: [sourceAnnotationId], references: [id], onDelete: Cascade)
  targetAnnotationId String
  targetAnnotation   LayersAnnotation @relation("RelTarget", fields: [targetAnnotationId], references: [id], onDelete: Cascade)

  /// JSON: { personaId, relationTypeId }.
  relationTypeRef Json
  label           String?
  features        Json?

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([layerId])
  @@index([sourceAnnotationId])
  @@index([targetAnnotationId])
  @@map("text_annotation_relations")
}

/// GraphNode mirrors graph.graphNode: a world object (entity, situation, claim,
/// etc.). `id` == the node Uuid.value (reuse the Fovea world-object id on backfill).
model GraphNode {
  id String @id @default(uuid())

  /// entity | situation | state | time | location | claim | concept | ...
  nodeType      String
  label         String?
  properties    Json?
  knowledgeRefs Json?
  metadata      Json?

  denotedByAnnotations LayersAnnotation[]

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeType])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("graph_nodes")
}

/// GraphEdge mirrors graph.graphEdge: a typed edge between world objects.
/// source/target hold objectRef value-objects; sourceLocalId/targetLocalId
/// denormalize the referenced node ids for indexed lookup.
model GraphEdge {
  id String @id @default(uuid())

  /// objectRef value-objects.
  source        Json
  target        Json
  sourceLocalId String?
  targetLocalId String?
  edgeType      String
  label         String?
  ordinal       Int?
  /// Confidence on the layers 0-1000 integer scale.
  confidence    Int?
  properties    Json?
  metadata      Json?

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceLocalId])
  @@index([targetLocalId])
  @@index([edgeType])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("graph_edges")
}

/// LayersOntology mirrors ontology.ontology: a named type system.
model LayersOntology {
  id String @id @default(uuid())

  name        String
  description String?
  version     String?
  domain      String?

  /// Self-relation: ontology extends a parent ontology.
  parentOntologyId String?
  parentOntology   LayersOntology?  @relation("OntologyTree", fields: [parentOntologyId], references: [id], onDelete: SetNull)
  childOntologies  LayersOntology[] @relation("OntologyTree")

  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)

  knowledgeRefs Json?

  typeDefs         TypeDef[]
  annotationLayers AnnotationLayer[]

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personaId])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("layers_ontologies")
}

/// TypeDef mirrors ontology.typeDef: one type in an ontology. `id` preserves the
/// original Fovea type id on backfill.
model TypeDef {
  id String @id @default(uuid())

  ontologyId String
  ontology   LayersOntology @relation(fields: [ontologyId], references: [id], onDelete: Cascade)

  name     String
  /// entity-type | situation-type | role-type | relation-type | attribute-type
  typeKind String
  gloss    String? @db.Text

  /// Self-relation: type extends a parent type.
  parentTypeId String?
  parentType   TypeDef?  @relation("TypeTree", fields: [parentTypeId], references: [id], onDelete: SetNull)
  childTypes   TypeDef[] @relation("TypeTree")

  allowedRoles  Json?
  allowedValues Json?
  knowledgeRefs Json?
  features      Json?

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ontologyId])
  @@index([typeKind])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("type_defs")
}

/// Corpus groups expressions into a named, versioned collection.
model Corpus {
  id String @id @default(uuid())

  name         String
  description  String?
  version      String?
  domain       String?
  ontologyRefs Json?
  languages    String[]
  metadata     Json?

  expressions Expression[]
  memberships CorpusMembership[]

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([createdByUserId])
  @@map("corpora")
}

/// CorpusMembership is the join between a corpus and one of its expressions,
/// carrying the split and ordinal for that membership.
model CorpusMembership {
  id String @id @default(uuid())

  corpusId     String
  corpus       Corpus     @relation(fields: [corpusId], references: [id], onDelete: Cascade)
  expressionId String
  expression   Expression @relation(fields: [expressionId], references: [id], onDelete: Cascade)

  split    String?
  ordinal  Int?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([corpusId, expressionId])
  @@index([corpusId])
  @@index([expressionId])
  @@map("corpus_memberships")
}

/// ClusterSet holds a clustering over annotations or expressions (e.g. coref).
model ClusterSet {
  id String @id @default(uuid())

  expressionId String?
  expression   Expression? @relation(fields: [expressionId], references: [id], onDelete: SetNull)
  corpusId     String?
  kind         String
  layerId      String?
  /// JSON: the clusters (members and cluster metadata).
  clusters     Json
  metadata     Json?

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expressionId])
  @@index([corpusId])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("cluster_sets")
}

/// Alignment links two token/annotation streams (e.g. source/target translation).
model Alignment {
  id String @id @default(uuid())

  expressionId String?
  expression   Expression? @relation(fields: [expressionId], references: [id], onDelete: SetNull)
  kind         String
  subkind      String?
  /// objectRef/streamRef value-objects for the two aligned sides.
  source       Json
  target       Json
  sourceLang   String?
  targetLang   String?
  /// JSON: the alignment links between source and target units.
  links        Json
  metadata     Json?

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUserId String?
  layersUri       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expressionId])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("alignments")
}
