  "panels": [
    {
      "title": "Permission Checks (Allowed vs Denied)",
      "type": "timeseries",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "stacking": { "group": "A", "mode": "normal" },
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "denied" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "allowed" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "sum by (result) (rate(fovea_rbac_checks_total[5m]))", "legendFormat": "{{result}}", "refId": "A" }
      ]
    },
    {
      "title": "Permission Checks by Role",
      "type": "bargauge",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        { "expr": "sum by (role) (increase(fovea_rbac_checks_total[1h]))", "legendFormat": "{{role}}", "refId": "A" }
      ]
    },
    {
