# Root .dockerignore for monorepo Docker builds (context: repo root).
# Each package Dockerfile (server/Dockerfile, annotation-tool/Dockerfile) only
# copies the workspace metadata it needs plus its own subdirectory, so this
# file mainly trims the build context to keep transfers small.

# Dependencies
**/node_modules
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Build output
**/dist
**/build
**/.docusaurus

# Testing
**/coverage
**/.nyc_output
**/*.lcov
**/playwright-report
**/test-results

# Editor / OS
**/.vscode
**/.idea
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/.eslintcache

# Environment
**/.env
**/.env.*
!**/.env.example

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Docker
**/Dockerfile*
**/docker-compose*
**/.dockerignore

# Python (model-service / wikibase) — Docker builds for those services
# use their own contexts.
model-service
wikibase

# Documentation site (docs has its own Dockerfile / build)
docs
DOCKER_QUICK_REFERENCE.md
*.md
!README.md

# Data / videos (mounted as volumes)
data
videos
test-videos
/server/data
/server/videos

# Logs
logs
**/*.log
